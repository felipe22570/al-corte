AI_MODEL_DEFAULT=

# Alert ingestion (H12, step 42). Server only; see integrations/apps-script/README.md (D51).
INGEST_SIGNING_SECRET=
INGEST_USER_ID=
SUPABASE_SECRET_KEY=
